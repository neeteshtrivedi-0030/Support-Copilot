# Server Environment & Port
NODE_ENV=development
SERVER_MODE=http
PORT=5000
API_PREFIX=/api/v1
CORS_ORIGIN=*
SITE_URL=http://localhost:5000

# SSL / HTTPS Configuration (Required when SERVER_MODE=https)
# SSL_KEY_PATH=/path/to/privkey.pem
# SSL_CERT_PATH=/path/to/fullchain.pem
# SSL_CA_PATH=/path/to/chain.pem

# MongoDB Connection (Required)
MONGODB_URI=mongodb://localhost:27017/support_copilot

# Redis Cache / Queue (Set REDIS_ENABLED=true if redis is running)
REDIS_ENABLED=false
REDIS_URL=redis://127.0.0.1:6379

# JWT Secrets (Required - minimum 16 characters)
JWT_SECRET=your_jwt_secret_key_min_16_chars
JWT_EXPIRES_IN=1d
JWT_REFRESH_SECRET=your_jwt_refresh_secret_key_min_16_chars
JWT_REFRESH_EXPIRES_IN=7d

# GenAI API Keys
OPENAI_API_KEY=
GEMINI_API_KEY=
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-120b

# Vector Database (memory | chroma | pinecone | qdrant | mongodb_atlas)
VECTOR_DB_TYPE=memory

# Object Storage / MinIO / S3 Configuration
S3_ENDPOINT=http://127.0.0.1:9000
S3_REGION=us-east-1
S3_BUCKET=support-copilot-documents
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin123
S3_FORCE_PATH_STYLE=true
S3_PUBLIC_URL=http://127.0.0.1:9000
